# ---- Database ----
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=password
DB_NAME=mess_monitor
# DB_POOL_SIZE=20

# ---- Web ----
GOOGLE_CLIENT_ID=964017053673-hg64g75ro6kbgl1345dats7ca0pgeq3s.apps.googleusercontent.com
# Comma-separated list of frontend origins allowed to call the API.
FRONTEND_ORIGIN=http://localhost:5173
# Public address of the site — used in QR codes and email links.
APP_BASE_URL=http://localhost:5173

# ---- Security ----
# Only used once: seeds the first all-colleges admin on an empty database.
# Change that account's password in Admin -> My account afterwards.
MESS_ADMIN_EMAIL=admin@traytrack.local
MESS_ADMIN_PASSWORD=changeme123
# Sessions are server-side, in HttpOnly cookies (no signing secret needed).
# STAFF_IDLE_HOURS=8            # staff signed out after this much inactivity
# STAFF_MAX_DAYS=7              # ...and at most this long after signing in
# STUDENT_IDLE_DAYS=7
# STUDENT_MAX_DAYS=30
# COOKIE_SAMESITE=lax           # "none" only if the API is on a different site than the frontend (HTTPS required)
# COOKIE_SECURE=auto            # Secure cookies automatically when APP_BASE_URL is https
# RATE_LIMIT_SCALE=1            # multiplies all rate limits; never below 1 in production
# E2E_TEST_LOGIN=0              # browser tests only; refused unless DB is traytrack_e2e*/test* on localhost
# REQUIRE_2FA_ROLES=admin,principal   # these roles must use two-factor sign-in ("" = optional for all)
# MIN_PASSWORD_LENGTH=10
# PWNED_PASSWORD_CHECK=0        # 1 = refuse passwords found in breaches (api.pwnedpasswords.com, k-anonymity)

# ---- Email (optional) ----
# Without these nothing is emailed; every attempt is still recorded under
# Admin -> Notifications. SMTP_APP_PASSWORD is a Google "App Password".
SMTP_EMAIL=
SMTP_APP_PASSWORD=
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_STARTTLS=1

# ---- Privacy ----
# Student identity is removed from reports after this many days.
RETENTION_DAYS=365
# Audit trail (activity log) kept this long.
# ACTIVITY_RETENTION_DAYS=730

# ---- Operations ----
# LOCAL_TZ=Asia/Kolkata          # schedules (weekly digest Monday 9:00) use this
# JOBS_ENABLED=1                 # background escalation/reminders/retention
# UPLOAD_DIR=./uploads
# LOG_DIR=./logs
# BACKUP_DIR=./backups
# BACKUPS_ENABLED=0              # 1 = verified nightly backup (on by default in docker-compose)
# BACKUP_HOUR=2                  # local hour (LOCAL_TZ)
# BACKUP_KEEP=30
# MYSQL=                         # mysql client for scripts/restore.py, if not on PATH
# OPS_ALERT_EMAIL=               # who hears about failed backups/jobs and error bursts (needs SMTP)
# OPS_WEBHOOK_URL=               # and/or a Slack/Discord/Teams incoming webhook
# OPS_ERROR_BURST=10             # this many 5xx in 5 minutes raises an alert
# METRICS_TOKEN=                 # enables GET /metrics (Prometheus) with this bearer token
# MYSQLDUMP=C:\path\to\mysqldump.exe
# SENTRY_DSN=                    # optional error tracking (pip install sentry-sdk)
